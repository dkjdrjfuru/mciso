# ==============================================================
#  Netmask OS (full) — pinned versions for non-APT tooling
#  Sourced by every scripts/install-*.sh module.
#  Bump deliberately; CI builds are reproducible per-commit.
# ==============================================================

# --- Ghidra ---------------------------------------------------
# 11.4.2 = last release supporting JDK 17 (bookworm main has no JDK 21).
# Upgrade path: add openjdk-21 (backports/trixie) then bump to Ghidra 12.x.
GHIDRA_VERSION=11.4.2
GHIDRA_URL="https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_11.4.2_build/ghidra_11.4.2_PUBLIC_20250826.zip"

# --- language toolchains --------------------------------------
GO_VERSION=1.27.3
NODE_VERSION=20.20.2
RUST_PROFILE=stable          # rustup channel; pin e.g. 1.90.0 for hard reproducibility

# --- pinned GitHub-release tools -------------------------------
KUBE_BENCH_VERSION=0.16.0

# --- floating (resolved to latest release at build time) -------
# radare2, rizin, Cutter, upx, bettercap, trivy, MemProcFS, DIE, PE-bear,
# DynamoRIO, ZAP, jadx, dex2jar, stegseek, Metasploit (omnibus nightly):
# resolved via scripts/lib/gh-release.sh; versions.env may pin them by
# exporting e.g. UPX_VERSION=4.2.4 — see each installer.
METASPLOIT_CHANNEL=latest

# --- not distributable ----------------------------------------
# Binary Ninja: no demo build exists (license-gated) — see KNOWN-LIMITATIONS.md
