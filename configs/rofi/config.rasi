// ~/.config/rofi/config.rasi — Netmask OS launcher (matrix theme)

configuration {
    modi: "run,drun,window";
    show-icons: true;
    matching: "fuzzy";
    case-sensitive: false;
    font: "FiraCode Nerd Font 11";
    display-run: "execute";
    display-drun: "apps";
    display-window: "windows";
    display-combi: "netmask";
    combi-modi: "window,run,drun";
    terminal: "kitty";
    cycle: true;
    sort: true;
    sorting-method: "levenshtein";
}

* {
    bg0: rgba ( 13, 13, 26, 94 % );
    bg1: rgba ( 20, 20, 43, 94 % );
    fg0: #E0E0E0;
    fg1: #8A8AA8;
    cyan: #00D9FF;
    green: #27AE60;
    red: #E94560;

    background-color: @bg0;
    text-color: @fg0;
}

window {
    width: 44em;
    border: 2px;
    border-color: @green;
    padding: 12px;
}

inputbar {
    background-color: @bg1;
    border: 0 0 2px 0;
    border-color: @cyan;
    padding: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @green;
}

entry {
    placeholder: "search the grid...";
    placeholder-color: @fg1;
}

listview {
    lines: 12;
    scrollbar: true;
    scrollbar-width: 6px;
    scrollbar-handle-color: @cyan;
    fixed-height: false;
}

element {
    padding: 4px 8px;
}

element selected {
    background-color: @bg1;
    text-color: @cyan;
    border: 0 0 0 2px;
    border-color: @green;
}

element-text {
    text-color: inherit;
}

sidebar {
    background-color: @bg1;
}

textbox-num-sep {
    text-color: @fg1;
}
