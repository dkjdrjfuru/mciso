# ~/.config/i3/config — Netmask OS (Windows-style desktop)
# i3 4.22+ (i3-gaps features are merged upstream since 4.22)
#
# Layout: full-bleed tiled windows (no gaps), real title bars, and one
# bottom taskbar (Start | running apps | tray | clock) like Windows —
# but in the Netmask hacker palette (bg #0D0D1A, accent #00D9FF).

set $mod Mod4
set $term kitty

font pango:Inter 9

# --- Windows-like window chrome ---
gaps inner 0
gaps outer 0
default_border normal 2
default_floating_border normal 2
title_align left
focus_follows_mouse no

# --- Netmask colors (cyan = focused accent, like the Windows accent color) ---
client.focused          #00D9FF #14142B #E0E0E0 #00D9FF #00D9FF
client.focused_inactive #4A4A6A #14142B #8A8AA8 #4A4A6A #4A4A6A
client.unfocused        #22223E #0D0D1A #8A8AA8 #22223E #22223E
client.urgent           #E94560 #E94560 #0D0D1A #E94560 #E94560
client.placeholder      #22223E #0D0D1A #8A8AA8 #22223E #22223E
client.background       #0D0D1A

# dialogs float (like Windows modal windows)
for_window [window_type="dialog"] floating enable

# --- startup: Windows-style desktop shell ---
exec --no-startup-id picom -b --config ~/.config/picom/picom.conf
exec --no-startup-id dunst
exec --no-startup-id xfdesktop
exec --no-startup-id xfce4-panel
exec --no-startup-id xcape -e 'Super_L:F13;Super_R:F13'
exec --no-startup-id nm-applet

# --- start menu / run dialog (Windows muscle memory) ---
set $startmenu ~/.config/i3/scripts/start-menu.sh
bindsym F13 exec --no-startup-id $startmenu           # Win key alone -> Start
bindsym $mod+d exec --no-startup-id $startmenu
bindsym $mod+r exec --no-startup-id rofi -show run    # Win+R run box
bindsym $mod+e exec --no-startup-id pcmanfm           # Win+E file manager
bindsym Control+Mod1+l exec --no-startup-id i3lock -c 0D0D1A

# --- terminal / window keys ---
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym Mod1+F4 kill                                   # Alt+F4

# --- focus (vim + arrows) ---
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# --- move windows ---
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- split / layout ---
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+t layout toggle split    # $mod+e is now the file manager
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# --- workspaces (virtual desktops) ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# --- resize mode ($mod+x — $mod+r is now the run box) ---
bindsym $mod+x mode "resize"
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# --- session ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Leave Netmask OS?' -B 'Exit' 'i3-msg exit'"

# --- RE toolchain (full edition) ---
# Super+F1 toolchain navigator · Super+F2 tutorials · Super+F3 crackmes
# Super+G Ghidra · Super+Shift+W Burp (Web proxy)
bindsym $mod+F1 exec --no-startup-id kitty -e netmask-tools
bindsym $mod+F2 exec --no-startup-id kitty -e netmask-learn
bindsym $mod+F3 exec --no-startup-id kitty -e netmask-crackmes
bindsym $mod+g exec --no-startup-id ghidra
bindsym $mod+Shift+w exec --no-startup-id burp
